# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Same origin as the Vite frontend, credentials on for the httpOnly
# refresh-token cookie. Comma-separate multiple origins to allowlist more
# than one (e.g. staging + production): CORS_ORIGIN=https://a.com,https://b.com
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string — point this at your own instance/collection.
MONGODB_URI=mongodb://127.0.0.1:27017/bansalnx

# Access-token JWT secret — generate a real random value, e.g. `openssl rand -hex 64`.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_ACCESS_TTL=15m

# Refresh tokens are opaque + DB-backed (see modules/auth/models/session.model.ts),
# not JWTs — this only controls how long a session stays valid.
REFRESH_TOKEN_TTL_MS=604800000

# Password-reset links (opaque + DB-backed, same pattern as refresh tokens).
# 30 minutes, matching the copy already on ForgotPasswordPage.tsx.
PASSWORD_RESET_TTL_MS=1800000

# --- Image storage (optional) ---------------------------------------------
# Leave all three blank/unset to use local disk storage under backend/uploads
# (served at {APP_URL}/uploads/<file>) — works immediately, no account needed.
# Fill in all three to switch to Cloudinary instead, with zero code changes.
# Get these from https://cloudinary.com/console (free tier is enough for dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Transactional email (optional) ----------------------------------------
# Leave blank/unset to log emails to the console instead of sending them
# (see src/utils/email.ts) — the app works fully without this, just no real
# email is delivered. Fill in to send for real through any SMTP provider:
# Postmark, SES, Mailgun, Gmail (with an app password), Mailtrap for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS) — most
# providers use 587, so this usually stays false.
SMTP_SECURE=false
# Defaults to SMTP_USER if left blank.
EMAIL_FROM=
