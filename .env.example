# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Same origin as the Vite frontend, credentials on for the httpOnly
# refresh-token cookie.
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string — point this at your own instance/collection.
MONGODB_URI=mongodb://127.0.0.1:27017/bansalnx

# Access-token JWT secret — generate a real random value, e.g. `openssl rand -hex 64`.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_ACCESS_TTL=15m

# Refresh tokens are opaque + DB-backed (see modules/auth/models/session.model.ts),
# not JWTs — this only controls how long a session stays valid.
REFRESH_TOKEN_TTL_MS=604800000

# Password-reset links (opaque + DB-backed, same pattern as refresh tokens).
# 30 minutes, matching the copy already on ForgotPasswordPage.tsx.
PASSWORD_RESET_TTL_MS=1800000
